{
  "name": "game-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w @game/server\" \"npm run dev -w @game/client\"",
    "build": "npm run build -w @game/client",
    "start": "npm run start -w @game/server",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run build && tsx scripts/verify/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.48.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
